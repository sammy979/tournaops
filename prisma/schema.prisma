generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// USER
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  username     String       @unique
  displayName  String
  password     String
  avatar       String?
  isAdmin      Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tournaments  Tournament[]

  @@index([email])
  @@index([username])
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// TOURNAMENT
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

model Tournament {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  description   String?
  game          String   @default("pubg_mobile")
  status        String   @default("draft")
  format        String?
  prizePool     String?
  maxTeams      Int      @default(16)
  scoringRule   Json
  mapRotation   String[]
  overlayToken  String   @unique @default(cuid())
  isPublic      Boolean  @default(true)
  discord       String?
  rules         String?
  bannerImage   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String

  teams         Team[]
  matches       Match[]
  rounds        Round[]
  imports       DiscordImport[]

  stages        Stage[]
  progressions  TeamProgression[]
  auditLogs     QualifierAuditLog[]

  @@index([userId])
  @@index([slug])
  @@index([status])
}

model Team {
  id           String     @id @default(cuid())
  name         String
  tag          String?
  logo         String?
  seed         Int?
  contact      String?
  players      Json
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId String

  @@index([tournamentId])
  @@index([seed])
}

model Round {
  id              String     @id @default(cuid())
  name            String
  type            String
  matchesPerLobby Int
  advanceTop      Int?
  order           Int
  lobbies         Json

  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId    String

  @@index([tournamentId])
  @@index([order])
}

model Match {
  id                  String     @id @default(cuid())
  name                String
  roundId             String
  lobbyId             String
  map                 String
  status              String     @default("pending")
  matchNumber         Int?
  results             Json?
  startTime           DateTime?
  endTime             DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  stageId             String?
  groupId             String?

  // NEW: Qualifier extras
  notes               String?    @db.Text
  screenshotUrl       String?    @db.Text     // base64 or URL
  compensationData    Json?      // { teamId: points, ... }
  penaltyData         Json?      // { teamId: points, reason, ... }

  tournament          Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId        String

  @@index([tournamentId])
  @@index([status])
  @@index([roundId])
  @@index([stageId])
}

model DiscordImport {
  id                  String      @id @default(cuid())
  discordMessageId    String      @unique
  discordChannelId    String
  discordChannelName  String
  discordGuildId      String
  discordGuildName    String
  discordUserId       String
  discordUsername     String
  discordUserAvatar   String?
  messageContent      String      @db.Text
  parseResult         Json
  status              String      @default("pending")
  receivedAt          DateTime    @default(now())
  importedAt          DateTime?

  tournament          Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  tournamentId        String?

  @@index([status])
  @@index([discordGuildId])
  @@index([receivedAt])
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// MULTI-STAGE TOURNAMENT SYSTEM
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

model Stage {
  id                 String   @id @default(cuid())
  tournamentId       String
  name               String
  type               String
  order              Int
  status             String   @default("DRAFT")

  numGroups          Int      @default(1)
  teamsPerGroup      Int      @default(16)
  matchesPerGroup    Int      @default(4)
  totalTeams         Int

  startDate          DateTime?
  endDate            DateTime?
  registrationOpens  DateTime?
  registrationCloses DateTime?

  qualificationRule  Json
  teamsAdvancing     Int      @default(0)
  teamsEliminated    Int      @default(0)

  mapRotation        String[]
  scoringRule        Json
  tiebreakerOrder    String[] @default(["points", "kills", "damage", "wwcd"])

  isLocked           Boolean  @default(false)
  lockedAt           DateTime?
  lockedBy           String?

  description        String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tournament         Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groups             StageGroup[]
  progressions       TeamProgression[]
  auditLogs          QualifierAuditLog[]

  @@index([tournamentId, order])
  @@index([status])
}

model StageGroup {
  id           String   @id @default(cuid())
  stageId      String
  name         String
  order        Int      @default(0)
  teamIds      String[]
  matchIds     String[]
  status       String   @default("PENDING")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stage        Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId])
}

model TeamProgression {
  id              String    @id @default(cuid())
  tournamentId    String
  stageId         String
  teamId          String
  teamName        String

  entryPosition   Int?
  finalPosition   Int?
  points          Int       @default(0)
  kills           Int       @default(0)
  matchesPlayed   Int       @default(0)
  wwcds           Int       @default(0)

  status          String
  advancedToStageId String?
  manualOverride  Boolean   @default(false)
  overrideNote    String?

  createdAt       DateTime  @default(now())

  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stage           Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, teamId])
  @@index([tournamentId, teamId])
  @@index([stageId])
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// NEW: QUALIFIER AUDIT LOG
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

model QualifierAuditLog {
  id             String   @id @default(cuid())
  tournamentId   String
  stageId        String?
  teamId         String?
  teamName       String?

  action         String   // MANUAL_ADVANCE, MANUAL_ELIMINATE, EDIT_RESULT, ADD_COMPENSATION, ADD_PENALTY, LOCK_STAGE, UNLOCK_STAGE, RESET_STAGE
  reason         String   @db.Text
  metadata       Json?    // Additional context (old value, new value, etc.)

  performedBy    String
  performedAt    DateTime @default(now())

  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stage          Stage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@index([stageId])
  @@index([teamId])
  @@index([performedAt])
}