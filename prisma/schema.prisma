generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ORGANIZER
  SUPER_ADMIN
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  username             String              @unique
  displayName          String
  password             String
  avatar               String?
  googleId             String?             @unique
  isAdmin              Boolean             @default(false)
  isPro                Boolean             @default(false)
  role                 Role                @default(USER)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  dodoCustomerId       String?
  dodoSubscriptionId   String?
  theme                String              @default("dark")
  chatHistory          Json?               @default("[]")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  tournaments          Tournament[]
  chatMessages         ChatMessage[]
  UserScoringPreset    UserScoringPreset[]
  payments             Payment[]           @relation("UserPayments")
  reviewedPayments     Payment[]           @relation("PaymentReviewer")
  proGrantedAt         DateTime?
  proExpiresAt         DateTime?
  proGrantedBy         String?
  organizerName        String?
  organizerLogo        String?
  organizerBio         String?

  @@index([email])
  @@index([username])
}

model Tournament {
  id               String              @id @default(cuid())
  slug             String              @unique
  name             String
  description      String?
  game             String              @default("pubg_mobile")
  status           String              @default("draft")
  format           String?
  prizePool        String?
  maxTeams         Int                 @default(16)
  scoringRule      Json                @default("{}")
  mapRotation      String[]
  overlayToken     String              @unique @default(cuid())
  isPublic         Boolean             @default(true)
  discord          String?
  rules            String?
  bannerImage      String?
  brandingData     Json?
  scheduleData     Json?
  registrationData Json?
  trophyImage      String?
  coverImage       String?
  sponsorLogos     Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  userId           String
  imports          DiscordImport[]
  matches          Match[]
  auditLogs        QualifierAuditLog[]
  rounds           Round[]
  stages           Stage[]
  teams            Team[]
  progressions     TeamProgression[]
  createdBy        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([slug])
  @@index([status])
}

model Team {
  id           String     @id @default(cuid())
  name         String
  tag          String?
  logo         String?
  seed         Int?
  contact      String?
  players      Json
  banner       String?
  country      String?
  countryFlag  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playersList  Player[]

  @@index([tournamentId])
  @@index([seed])
}

model Round {
  id              String     @id @default(cuid())
  name            String
  type            String
  matchesPerLobby Int
  advanceTop      Int?
  order           Int
  lobbies         Json
  tournamentId    String
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([order])
}

model Match {
  id               String     @id @default(cuid())
  name             String
  roundId          String
  lobbyId          String
  map              String
  status           String     @default("pending")
  matchNumber      Int?
  results          Json?
  startTime        DateTime?
  endTime          DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  tournamentId     String
  groupId          String?
  stageId          String?
  compensationData Json?
  notes            String?
  penaltyData      Json?
  screenshotUrl    String?
  tournament       Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([stageId, groupId, matchNumber])
  @@index([tournamentId])
  @@index([status])
  @@index([roundId])
  @@index([stageId])
}

model DiscordImport {
  id                 String      @id @default(cuid())
  discordMessageId   String      @unique
  discordChannelId   String
  discordChannelName String
  discordGuildId     String
  discordGuildName   String
  discordUserId      String
  discordUsername    String
  discordUserAvatar  String?
  messageContent     String
  parseResult        Json
  status             String      @default("pending")
  receivedAt         DateTime    @default(now())
  importedAt         DateTime?
  tournamentId       String?
  tournament         Tournament? @relation(fields: [tournamentId], references: [id])

  @@index([status])
  @@index([discordGuildId])
  @@index([receivedAt])
}

model Stage {
  id                 String              @id @default(cuid())
  tournamentId       String
  name               String
  type               String
  order              Int
  status             String              @default("DRAFT")
  numGroups          Int                 @default(1)
  teamsPerGroup      Int                 @default(16)
  matchesPerGroup    Int                 @default(4)
  totalTeams         Int
  startDate          DateTime?
  endDate            DateTime?
  registrationOpens  DateTime?
  registrationCloses DateTime?
  qualificationRule  Json
  teamsAdvancing     Int                 @default(0)
  teamsEliminated    Int                 @default(0)
  mapRotation        String[]
  scoringRule        Json                @default("{}")
  tiebreakerOrder    String[]            @default(["points", "kills", "damage", "wwcd"])
  isLocked           Boolean             @default(false)
  lockedAt           DateTime?
  lockedBy           String?
  description        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  auditLogs          QualifierAuditLog[]
  tournament         Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groups             StageGroup[]
  progressions       TeamProgression[]

  @@unique([tournamentId, order])
  @@index([tournamentId, order])
  @@index([status])
}

model StageGroup {
  id        String   @id @default(cuid())
  stageId   String
  name      String
  order     Int      @default(0)
  teamIds   String[]
  matchIds  String[]
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stage     Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, order])
  @@index([stageId])
}

model TeamProgression {
  id                String     @id @default(cuid())
  tournamentId      String
  stageId           String
  teamId            String
  teamName          String
  entryPosition     Int?
  finalPosition     Int?
  points            Int        @default(0)
  kills             Int        @default(0)
  matchesPlayed     Int        @default(0)
  wwcds             Int        @default(0)
  status            String
  advancedToStageId String?
  manualOverride    Boolean    @default(false)
  overrideNote      String?
  createdAt         DateTime   @default(now())
  stage             Stage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  tournament        Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([stageId, teamId])
  @@index([tournamentId, teamId])
  @@index([stageId])
}

model QualifierAuditLog {
  id           String     @id @default(cuid())
  tournamentId String
  stageId      String?
  teamId       String?
  teamName     String?
  action       String
  reason       String
  metadata     Json?
  performedBy  String
  performedAt  DateTime   @default(now())
  stage        Stage?     @relation(fields: [stageId], references: [id])
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([stageId])
  @@index([teamId])
  @@index([performedAt])
}

model UserScoringPreset {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  scoringRule Json     @default("{}")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ChatMessage {
  id           String   @id @default(cuid())
  userId       String
  role         String
  content      String
  tournamentId String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model Player {
  id           String   @id @default(cuid())
  name         String
  ign          String?
  pubgId       String?
  role         String?
  photo        String?
  country      String?
  countryFlag  String?
  isCaptain    Boolean  @default(false)
  isSubstitute Boolean  @default(false)
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([teamId])
}

// --- PAYMENT SYSTEM -----------------------------------------------------------

enum PaymentMethod {
  ESEWA
  KHALTI
  BANK
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProSource {
  PAYMENT
  ADMIN_MANUAL
  PROMOTION
  COMP
  SYSTEM
}

model Payment {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)
  amount               Float
  currency             String        @default("NPR")
  method               PaymentMethod
  transactionReference String
  proofUrl             String?
  note                 String?
  status               PaymentStatus @default(PENDING)
  submittedAt          DateTime      @default(now())
  reviewedAt           DateTime?
  reviewedBy           String?
  reviewer             User?         @relation("PaymentReviewer", fields: [reviewedBy], references: [id])
  rejectionReason      String?
  adminNote            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([method])
  @@index([transactionReference])
  @@index([submittedAt])
}

model PaymentSettings {
  id                   String   @id @default(cuid())
  esewaEnabled         Boolean  @default(false)
  esewaQrUrl           String?
  esewaAccountName     String?
  esewaAccountId       String?
  esewaInstructions    String?
  khaltiEnabled        Boolean  @default(false)
  khaltiQrUrl          String?
  khaltiAccountName    String?
  khaltiAccountId      String?
  khaltiInstructions   String?
  bankEnabled          Boolean  @default(false)
  bankName             String?
  bankQrUrl            String?
  bankAccountHolder    String?
  bankAccountNumber    String?
  bankBranch           String?
  bankInstructions     String?
  internationalEnabled Boolean  @default(false)
  updatedAt            DateTime @updatedAt
  updatedBy            String?
}

model SystemError {
  id              String    @id @default(cuid())
  fingerprint     String    @unique
  severity        String    @default("ERROR")
  route           String?
  errorType       String?
  message         String
  requestId       String?
  userId          String?
  tournamentId    String?
  occurrenceCount Int       @default(1)
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  resolved        Boolean   @default(false)
  resolvedAt      DateTime?
  resolvedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([severity])
  @@index([route])
  @@index([fingerprint])
  @@index([firstSeenAt])
  @@index([resolved])
}
